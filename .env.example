# Base de données Postgres (Neon via Vercel Marketplace en prod, Homebrew en local)
DATABASE_URL=postgres://user@localhost:5432/taquet_payload

# Chiffrement des JWT Payload : openssl rand -hex 24
PAYLOAD_SECRET=CHANGE_ME

# URL publique du site, sans slash final
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret des aperçus / revalidation : openssl rand -hex 16
PREVIEW_SECRET=CHANGE_ME

# Stockage des images en prod (Vercel Blob). Vide en local = fichiers dans public/media
BLOB_READ_WRITE_TOKEN=

# Envoi d'email du formulaire de contact (Resend). Vide = messages seulement stockés dans l'admin
RESEND_API_KEY=
CONTACT_TO_EMAIL=
